@page "{id:guid}"
@model Bloggie.Web.Pages.Admin.Blogs.EditModel
@{
}

<!-- HEADER: just shows the page title -->
<div class="bg-secondary bg-opacity-10 py-2 mb-5">
    <div class="container">
        <h1>Edit Blog Post</h1>
    </div>
</div>

<partial name="_Notification"/>
@if(Model.BlogPost != null)
{
    <!-- MAIN FORM: everything inside here gets sent when user clicks submit -->
    <div>
    <div class="container">
        <form method="post">

            
            <div class="mb-3">
                <label for="heading" class="form-label">Id</label>
                
                <input type="input" class="form-control" id="id" asp-for="BlogPost.Id" readonly required>
                <span class="text-danger" asp-validation-for="BlogPost.Id"></span>
                </div>

         
                <div class="mb-3">
                    <label for="heading" class="form-label">Heading</label>
                    <input type="text" class="form-control" id="heading" asp-for="BlogPost.Heading" required>
                    <span class="text-danger" asp-validation-for="BlogPost.Heading"></span>
                    </div>

                
                    <div class="mb-3">
                        <label for="pagetitle" class="form-label">Page Title</label>
                    <input type="text" class="form-control" id="pagetitle" asp-for="BlogPost.PageTitle" required>
                    <span class="text-danger" asp-validation-for="BlogPost.PageTitle"></span>
                        </div>

                        <div class="mb-3">
                            <label for="content" class="form-label">Content</label>
                    <textarea class="form-control" id="content" rows="3" asp-for="BlogPost.Content" required></textarea>
                    <span class="text-danger" asp-validation-for="BlogPost.PageTitle"></span>
                        </div>

                        <div class="mb-3">
                            <label for="shortDescription" class="form-label">Short Description</label>
                    <input type="text" class="form-control" id="shortDescription" asp-for="BlogPost.ShortDescription" required>
                    <span class="text-danger" asp-validation-for="BlogPost.PageTitle"></span>
                            </div>

                                <!--Feature Image to pick for uploading-->
                                <div class="mb-3">
                                    <label for="featuredImageUpload" class="form-label">Feature Image Upload</label>
                                    <input type="file" id="featuredImageUpload" asp-for="FeaturedImage" />

                                    @if (!string.IsNullOrWhiteSpace(Model.BlogPost.FeaturedImageUrl))
                                    {
                                        <img src="@Model.BlogPost.FeaturedImageUrl"
                                             id="featuredImageDisplay"
                                             style="width:300px; margin-top:10px;" />
                                    }
                                    else
                                    {
                                        <img src=""
                                             id="featuredImageDisplay"
                                             style="display:none; width:300px; margin-top:10px;" />
                                    }
                                </div>

                            <div class="mb-3">
                                <label for="featureImageUrl" class="form-label">Feature Image Url</label>
                    <input type="text" class="form-control" id="featureImageUrl" asp-for="BlogPost.FeaturedImageUrl" required>
                                <span class="text-danger" asp-validation-for="BlogPost.FeaturedImageUrl"></span>
                                </div>

                                <div class="mb-3">
                                    <label for="urlHandel" class="form-label">Url Handle</label>
                    <input type="text" class="form-control" id="urlHandel" asp-for="BlogPost.UrlHandle" required>
                                    <span class="text-danger" asp-validation-for="BlogPost.PageTitle"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label for="publishedDate" class="form-label">Published Date</label>
                    <input type="date" class="form-control" id="publishedDate" asp-for="BlogPost.PublishedDate" required>
                                        <span class="text-danger" asp-validation-for="BlogPost.PublishedDate"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label for="author" class="form-label">Author</label>
                    <input type="text" class="form-control" id="author" asp-for="BlogPost.Author" required>
                                            <span class="text-danger" asp-validation-for="BlogPost.Author"></span>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Tags (comma separated)</label>
                                                 <input type="text" id="tags" class=form-control asp-for="Tags" required />
                                                <span class="text-danger" asp-validation-for="Tags"></span>

                                            <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="isVisible" asp-for="BlogPost.Visible">
                                                    <label class="form-check-label" for="isVisible">
                                                        Is Visible
                                                    </label>
                                                </div>

                                                <!-- SUBMIT BUTTON: sends all form data to backend -->
                                                <div class="mb-3 d-flex justify-content-between">
                                                        <button class="btn btn-primary" type="submit" asp-page-handler="Edit">Submit</button>

                                                    <button class="btn btn-danger" type="submit" asp-page-handler="Delete">
                                                        Delete
                                                    </button>
                                                </div>

                                            </form>
                                        </div>
                                    </div>
}
else
{
    <div class="container">
        <p>Blog Post Not Found!</p>
    </div>
}

@section Scripts {
<script>
var editor = new FroalaEditor('#content', {
    imageUploadURL: '/api/images'
});

const featuredImageUploadElement = document.getElementById('featuredImageUpload');
const featuredImageUrl = document.getElementById('featureImageUrl');
const featuredImageDisplay = document.getElementById('featuredImageDisplay');

async function uploadFeatureImage(e) {
    let data = new FormData();
    data.append('file', e.target.files[0]);

    const response = await fetch('/api/images', {
        method: 'POST',
        body: data
    });

    const result = await response.json();

    featuredImageUrl.value = result.link;

    featuredImageDisplay.src = result.link;
    featuredImageDisplay.style.display = 'block';
}

featuredImageUploadElement.addEventListener('change', uploadFeatureImage);
</script>
}
